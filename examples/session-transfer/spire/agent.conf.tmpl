agent {
  data_dir = "DATA_DIR"
  log_level = "INFO"
  server_address = "127.0.0.1"
  server_port = "8081"
  socket_path = "SOCKET_PATH"
  trust_bundle_path = "BUNDLE_PATH"
  trust_domain = "infer.local"
  join_token = "JOIN_TOKEN"
}

plugins {
  KeyManager "disk" {
    plugin_data {
      directory = "DATA_DIR"
    }
  }
  NodeAttestor "join_token" {
    plugin_data {}
  }
  WorkloadAttestor "unix" {
    plugin_data {}
  }
}
